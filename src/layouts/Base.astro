---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const session = Astro.locals.session;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/pepe-icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} | PepeHub</title>
    <style>
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 11, 0.82);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
      }
      .nav-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 62px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        color: var(--text);
      }
      .brand:hover {
        color: var(--text);
      }
      .brand .logo {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: block;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.08;
      }
      .brand-name {
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -0.01em;
      }
      .brand-name .hub {
        color: var(--accent-soft);
      }
      .brand .tag {
        font-size: 11px;
        font-weight: 500;
        color: var(--dim);
        margin-top: 1px;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 22px;
        margin-left: auto;
      }
      .nav-links a {
        color: var(--muted);
        font-size: 15px;
        font-weight: 500;
      }
      .nav-links a:hover {
        color: var(--text);
      }
      .auth {
        display: flex;
        align-items: center;
        gap: 14px;
      }
      .auth-handle {
        color: var(--dim);
        font-size: 14px;
      }
      .auth-login {
        color: var(--accent-soft);
        font-weight: 600;
      }
      main {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 2.75rem 24px 5rem;
      }
    </style>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/">
          <img class="logo" src="/pepe-icon.svg" width="42" height="42" alt="Pepe" />
          <span class="brand-text">
            <span class="brand-name">Pepe<span class="hub">Hub</span></span>
            <span class="tag">registry</span>
          </span>
        </a>
        <nav class="nav-links">
          <a href="/?kind=skill">Skills</a>
          <a href="/?kind=plugin">Plugins</a>
          <a href="/?sort=official">Official</a>
          <a href="/publish">Docs</a>
          <a href="/publish/upload">Publicar</a>
          {session ? (
            <span class="auth">
              <span class="auth-handle">@{session.handle}</span>
              <a href="/logout">Sair</a>
            </span>
          ) : (
            <a class="auth-login" href="/login">Entrar com GitHub</a>
          )}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
