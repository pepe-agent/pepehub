---
import { useTranslations } from '../i18n/utils';
import { categoryLabels } from '../lib/constants';
import type { SearchResultItem } from '../lib/db';

interface Props {
  item: SearchResultItem;
}
const { item } = Astro.props;
const t = useTranslations(Astro.locals.locale);
const CATEGORY_LABELS = categoryLabels(Astro.locals.locale);
const detailHref = `/${item.kind === 'skill' ? 'skills' : 'packages'}/${item.name}`;
---

<a class="card package-card" href={detailHref}>
  <div class="row">
    <strong class="name">{item.name}</strong>
    {item.official ? <span class="badge official">{t.card.official}</span> : null}
  </div>
  <p class="summary">{item.summary ?? t.card.noSummary}</p>
  <div class="meta">
    <span class="badge">{CATEGORY_LABELS[item.category] ?? item.category}</span>
    <span>@{item.owner_handle}</span>
    <span>{item.downloads_count} {t.card.downloads}</span>
  </div>
</a>

<style>
  .package-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  .package-card:hover {
    border-color: #3f3f46;
    color: inherit;
  }
  .package-card .row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .package-card .name {
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .package-card .summary {
    color: var(--muted);
    margin: 0.4rem 0 0.8rem;
    font-size: 0.92rem;
  }
  .package-card .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.82rem;
    color: var(--dim);
  }
</style>
