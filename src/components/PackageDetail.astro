---
import { CATEGORY_LABELS } from '../lib/constants';
import type { PackageRow, PackageVersionRow } from '../lib/db';
import { serializeVersion } from '../lib/serialize';

interface Props {
  pkg: PackageRow;
  ownerHandle: string;
  versions: PackageVersionRow[];
}
const { pkg, ownerHandle, versions } = Astro.props;
---

<article>
  <header class="detail-header">
    <h1>{pkg.name}</h1>
    {pkg.official ? <span class="badge official">oficial</span> : null}
  </header>
  <p class="meta">
    <span>por @{ownerHandle}</span>
    <span class="badge">{CATEGORY_LABELS[pkg.category] ?? pkg.category}</span>
    <span>{pkg.downloads_count} downloads</span>
  </p>
  {pkg.summary ? <p class="summary">{pkg.summary}</p> : null}

  <h2>Versões</h2>
  {
    versions.length === 0 ? (
      <p>Nenhuma versão publicada ainda.</p>
    ) : (
      <ul class="versions">
        {versions.map((v) => {
          const version = serializeVersion(v);
          const downloadHref = `/api/v1/packages/${pkg.name}/versions/${version.version}/download`;
          return (
            <li class="card version-row">
              <div class="version-row-header">
                <strong>{version.version}</strong>
                <a class="download-link" href={downloadHref}>
                  Baixar
                </a>
              </div>
              {version.changelog ? <p class="changelog">{version.changelog}</p> : null}
              {version.requires ? (
                <p class="requires">
                  requires: <code>{JSON.stringify(version.requires)}</code>
                </p>
              ) : null}
              <p class="sha256">sha256: <code>{version.sha256}</code></p>
            </li>
          );
        })}
      </ul>
    )
  }
</article>

<style>
  .detail-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .detail-header h1 {
    margin: 0;
    font-size: clamp(24px, 4vw, 32px);
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.6rem 0 1.25rem;
  }
  .summary {
    max-width: 60ch;
    color: var(--muted);
  }
  h2 {
    font-size: 1.15rem;
    margin: 2rem 0 1rem;
  }
  .versions {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }
  .version-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .download-link {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 8px;
    background: var(--panel-2);
    border: 1px solid var(--border);
  }
  .download-link:hover {
    border-color: var(--accent-soft);
    color: var(--accent-soft);
  }
  .changelog,
  .requires,
  .sha256 {
    color: var(--dim);
    font-size: 0.85rem;
    margin: 0.5rem 0 0;
  }
</style>
