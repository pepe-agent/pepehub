---
import { useTranslations } from '../i18n/utils';
import { PEPE_PLUGINS_DOCS_URL, PEPE_SKILLS_DOCS_URL } from '../lib/constants';
import Base from '../layouts/Base.astro';

const t = useTranslations(Astro.locals.locale);
---

<Base title={t.publishDocs.title}>
  <h1>{t.publishDocs.title}</h1>

  <h2>{t.publishDocs.step1Title}</h2>
  <p>{t.publishDocs.step1Lead}</p>
  <ol>
    <li>{t.publishDocs.step1Item1}</li>
    <li>{t.publishDocs.step1Item2}</li>
    <li>{t.publishDocs.step1Item3}</li>
  </ol>

  <h2>{t.publishDocs.step2Title}</h2>
  <p>{t.publishDocs.step2Lead1}</p>
  <p>
    {t.publishDocs.step2Lead2}{' '}
    <a href={PEPE_SKILLS_DOCS_URL} rel="noopener">{t.publishDocs.step2Skills}</a> {t.common.and}
    <a href={PEPE_PLUGINS_DOCS_URL} rel="noopener">{t.publishDocs.step2Plugins}</a>.
  </p>

  <h2>{t.publishDocs.step3Title}</h2>
  <div class="terminal">
    <div class="bar"><i></i><i></i><i></i></div>
    <pre><code>pepe skill publish</code></pre>
  </div>
  <p>{t.publishDocs.step3Lead}</p>

  <h2>{t.publishDocs.step4Title}</h2>
  <p>
    {t.publishDocs.step4Lead} <a href="/publish/upload">{t.publishDocs.step4Link}</a>.
  </p>
</Base>

<style>
  h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(26px, 4vw, 36px);
  }
  h2 {
    font-size: 1.2rem;
    margin: 2.25rem 0 0.85rem;
  }
  p,
  li {
    color: var(--muted);
    line-height: 1.7;
  }
  ol {
    padding-left: 1.2rem;
  }
  li + li {
    margin-top: 0.5rem;
  }
  .terminal {
    max-width: 480px;
    margin: 0.5rem 0 1.25rem;
  }
</style>
