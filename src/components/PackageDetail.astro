---
import { useTranslations } from '../i18n/utils';
import { CATEGORIES } from '../lib/categories';
import { categoryLabels } from '../lib/constants';
import type { PackageRow, PackageVersionRow } from '../lib/db';
import type { SessionPayload } from '../lib/session';
import { serializeVersion } from '../lib/serialize';

interface Props {
  pkg: PackageRow;
  ownerHandle: string;
  versions: PackageVersionRow[];
  session: SessionPayload | null;
  starsCount: number;
  hasStarred: boolean;
}
const { pkg, ownerHandle, versions, session, starsCount, hasStarred } = Astro.props;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const CATEGORY_LABELS = categoryLabels(locale);
const isOwner = session?.ownerId === pkg.owner_id;
const latestVersion = versions[0] ?? null;
const installCmd = `pepe ${pkg.kind} install ${pkg.name}`;
const readmeTabLabel = pkg.kind === 'skill' ? t.packageDetail.tabReadmeSkill : t.packageDetail.tabReadmePlugin;

const SCAN_LABELS: Record<string, string> = {
  pending: t.packageDetail.scanPending,
  clean: t.packageDetail.scanClean,
  review: t.packageDetail.scanReview,
  warning: t.packageDetail.scanWarning,
  malicious: t.packageDetail.scanMalicious,
  error: t.packageDetail.scanError,
};
const SCAN_CLASSES: Record<string, string> = {
  clean: 'scan-clean',
  review: 'scan-warning',
  warning: 'scan-warning',
  malicious: 'scan-malicious',
};

// Formato fixo dd/mm/aaaa em vez de toLocaleDateString com mês por extenso:
// "12 de ago. de 2026" quebra linha na sidebar estreita (260px). Um formato
// numérico curto nunca quebra, e continua sem ambiguidade entre idiomas
// (dd/mm, não mm/dd).
function formatDate(iso: string): string {
  const date = new Date(iso);
  const day = String(date.getUTCDate()).padStart(2, '0');
  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
  const year = date.getUTCFullYear();
  return `${day}/${month}/${year}`;
}

const versionsWithRequires = versions
  .map((v) => serializeVersion(v))
  .filter((v) => v.requires !== null);
---

<article class="detail">
  <nav class="breadcrumb">
    <a href={`/?kind=${pkg.kind}`}>{pkg.kind === 'skill' ? t.packageDetail.breadcrumbSkills : t.packageDetail.breadcrumbPlugins}</a>
    <span>/</span>
    <a href={`/?category=${pkg.category}&kind=${pkg.kind}`}>{CATEGORY_LABELS[pkg.category] ?? pkg.category}</a>
    <span>/</span>
    <span>{pkg.name}</span>
  </nav>

  <header class="detail-header">
    <h1>{pkg.name}</h1>
    {pkg.official ? <span class="badge official">{t.card.official}</span> : null}
    {isOwner ? (
      <button type="button" id="edit-toggle" class="edit-toggle">
        {t.packageDetail.edit}
      </button>
    ) : null}
  </header>
  <p class="meta">
    <span>{t.packageDetail.by} @{ownerHandle}</span>
    <span id="category-display" class="badge">{CATEGORY_LABELS[pkg.category] ?? pkg.category}</span>
    <span>{pkg.downloads_count} {t.packageDetail.downloads}</span>
  </p>
  <p id="summary-display" class="summary">{pkg.summary ?? ''}</p>

  {
    isOwner && (
      <form id="metadata-form" class="card metadata-form" novalidate hidden>
        <div class="field">
          <label for="metadata-summary">{t.packageDetail.summaryLabel}</label>
          <textarea id="metadata-summary" name="summary" rows="6" placeholder={t.upload.summaryPlaceholder}>{pkg.summary ?? ''}</textarea>
        </div>
        <div class="field">
          <label for="metadata-category">{t.packageDetail.categoryLabel}</label>
          <select id="metadata-category" name="category">
            {CATEGORIES.map((cat) => (
              <option value={cat} selected={cat === pkg.category}>
                {CATEGORY_LABELS[cat] ?? cat}
              </option>
            ))}
          </select>
        </div>
        <div class="metadata-actions">
          <button type="submit" class="btn btn-primary">{t.packageDetail.save}</button>
          <button type="button" id="metadata-cancel" class="btn btn-ghost">{t.packageDetail.cancel}</button>
        </div>
        <p id="metadata-status" class="status"></p>
      </form>
    )
  }

  <div class="layout">
    <div class="main-col">
      <div class="tabs-nav" role="tablist">
        <button type="button" class="tab-btn active" data-tab="readme">{readmeTabLabel}</button>
        <button type="button" class="tab-btn" data-tab="files">{t.packageDetail.tabFiles}</button>
        <button type="button" class="tab-btn" data-tab="diff">{t.packageDetail.tabDiff}</button>
        <button type="button" class="tab-btn" data-tab="versions">{t.packageDetail.tabVersions}</button>
        <button type="button" class="tab-btn" data-tab="requirements">{t.packageDetail.tabRequirements}</button>
      </div>

      <div class="tab-panel" data-panel="readme">
        {
          latestVersion ? (
            <div id="readme-body" class="readme-body">
              <p class="tab-loading">{t.packageDetail.loadingLabel}</p>
            </div>
          ) : (
            <p class="tab-empty">{t.packageDetail.noVersionYet}</p>
          )
        }
      </div>

      <div class="tab-panel" data-panel="files" hidden>
        {
          latestVersion ? (
            <div class="files-layout">
              <ul id="files-list" class="files-list">
                <li class="tab-loading">{t.packageDetail.loadingLabel}</li>
              </ul>
              <pre id="file-viewer" class="file-viewer"><code>{t.packageDetail.selectFile}</code></pre>
            </div>
          ) : (
            <p class="tab-empty">{t.packageDetail.noVersionYet}</p>
          )
        }
      </div>

      <div class="tab-panel" data-panel="diff" hidden>
        {
          versions.length >= 2 ? (
            <>
              <div class="diff-controls">
                <select id="diff-from">
                  {versions.map((v, i) => (
                    <option value={v.version} selected={i === 1}>
                      {v.version}
                    </option>
                  ))}
                </select>
                <span class="diff-arrow">{t.packageDetail.diffTo}</span>
                <select id="diff-to">
                  {versions.map((v, i) => (
                    <option value={v.version} selected={i === 0}>
                      {v.version}
                    </option>
                  ))}
                </select>
              </div>
              <div id="diff-body" class="diff-body">
                <p class="tab-loading">{t.packageDetail.loadingLabel}</p>
              </div>
            </>
          ) : (
            <p class="tab-empty">{t.packageDetail.needTwoVersions}</p>
          )
        }
      </div>

      <div class="tab-panel" data-panel="versions" hidden>
        {
          versions.length === 0 ? (
            <p class="tab-empty">{t.packageDetail.noVersionYet}</p>
          ) : (
            <ul class="versions">
              {versions.map((v) => {
                const version = serializeVersion(v);
                const downloadHref = `/api/v1/packages/${pkg.name}/versions/${version.version}/download`;
                return (
                  <li class="card version-row">
                    <div class="version-row-header">
                      <strong>{version.version}</strong>
                      <a class="download-link" href={downloadHref}>
                        {t.packageDetail.download}
                      </a>
                    </div>
                    {version.scan ? (
                      <p class={`badge scan-badge ${SCAN_CLASSES[version.scan.status] ?? ''}`}>
                        {SCAN_LABELS[version.scan.status] ?? version.scan.status}
                      </p>
                    ) : null}
                    {version.changelog ? <p class="changelog">{version.changelog}</p> : null}
                    <p class="sha256">
                      {t.packageDetail.sha256Label} <code>{version.sha256}</code>
                    </p>
                  </li>
                );
              })}
            </ul>
          )
        }
      </div>

      <div class="tab-panel" data-panel="requirements" hidden>
        {
          versionsWithRequires.length === 0 ? (
            <p class="tab-empty">{t.packageDetail.noRequirements}</p>
          ) : (
            <ul class="requirements-list">
              {versionsWithRequires.map((v) => (
                <li class="card">
                  <strong>{v.version}</strong>
                  <pre><code>{JSON.stringify(v.requires, null, 2)}</code></pre>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <aside class="sidebar">
      <div class="card sidebar-card">
        <dl class="sidebar-meta">
          <div class="sidebar-meta-row">
            <dt>{t.packageDetail.updated}</dt>
            <dd>{formatDate(pkg.updated_at)}</dd>
          </div>
          {latestVersion && (
            <div class="sidebar-meta-row">
              <dt>{t.packageDetail.latestVersion}</dt>
              <dd>{latestVersion.version}</dd>
            </div>
          )}
        </dl>
        {latestVersion?.scan_status && (
          <p class={`badge scan-badge sidebar-scan ${SCAN_CLASSES[latestVersion.scan_status] ?? ''}`}>
            {SCAN_LABELS[latestVersion.scan_status] ?? latestVersion.scan_status}
          </p>
        )}

        {session ? (
          <button
            type="button"
            id="star-toggle"
            class="btn btn-ghost sidebar-action"
            data-starred={hasStarred ? 'true' : 'false'}
          >
            <span id="star-label">{hasStarred ? t.packageDetail.starred : t.packageDetail.star}</span> (<span id="stars-count">{starsCount}</span>)
          </button>
        ) : (
          <a class="btn btn-ghost sidebar-action" href="/login">
            {t.packageDetail.loginToStar}
          </a>
        )}

        {session && (
          <>
            <button type="button" id="report-toggle" class="btn btn-ghost sidebar-action">
              {t.packageDetail.report}
            </button>
            <form id="report-form" class="report-form" novalidate hidden>
              <label for="report-reason">{t.packageDetail.reportReasonLabel}</label>
              <textarea id="report-reason" name="reason" rows="3" placeholder={t.packageDetail.reportReasonPlaceholder} />
              <div class="report-actions">
                <button type="submit" class="btn btn-primary">{t.packageDetail.reportSend}</button>
                <button type="button" id="report-cancel" class="btn btn-ghost">{t.packageDetail.reportCancel}</button>
              </div>
              <p id="report-status" class="status"></p>
            </form>
          </>
        )}

        <div class="install-hint">
          <p class="install-hint-label">{t.packageDetail.installLabel}</p>
          <div class="terminal">
            <div class="bar"><i></i><i></i><i></i></div>
            <pre><code>{installCmd}</code></pre>
          </div>
        </div>
      </div>
    </aside>
  </div>
</article>

<style>
  .breadcrumb {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--dim);
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--dim);
  }
  .breadcrumb a:hover {
    color: var(--accent-soft);
  }
  .detail-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .detail-header h1 {
    margin: 0;
    font-size: clamp(24px, 4vw, 32px);
  }
  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.6rem 0 1.25rem;
  }
  .summary {
    max-width: 60ch;
    color: var(--muted);
    white-space: pre-wrap;
  }
  .summary:empty {
    display: none;
  }
  .edit-toggle {
    margin-left: auto;
    background: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }
  .edit-toggle:hover {
    border-color: var(--accent-soft);
    color: var(--accent-soft);
  }
  .metadata-form {
    max-width: 480px;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .metadata-form[hidden] {
    display: none;
  }
  .metadata-form .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .metadata-form label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .metadata-form input,
  .metadata-form select,
  .metadata-form textarea {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    padding: 8px 10px;
  }
  .metadata-form textarea {
    resize: vertical;
  }
  .metadata-form .field.field-error input,
  .metadata-form .field.field-error select,
  .metadata-form .field.field-error textarea {
    border-color: #f87171;
  }
  .metadata-actions {
    display: flex;
    gap: 10px;
  }
  .status {
    margin: 0;
    font-size: 13px;
    min-height: 1.2em;
  }
  .status.error {
    color: #f87171;
  }
  .status.success {
    color: var(--green);
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 28px;
    align-items: start;
    margin-top: 1.75rem;
  }
  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .tabs-nav {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
    overflow-x: auto;
  }
  .tab-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.6rem 0.85rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .tab-btn:hover {
    color: var(--text);
  }
  .tab-btn.active {
    color: var(--text);
    border-color: var(--accent);
  }
  .tab-panel[hidden] {
    display: none;
  }
  /* :global() nas classes abaixo porque JS cria esses elementos em
     runtime (document.createElement / innerHTML nas abas Files/Diff);
     o CSS escopado do Astro só se aplica a elementos que já existiam
     no HTML renderizado pelo servidor, nunca aos criados depois. */
  :global(.tab-loading),
  :global(.tab-empty) {
    color: var(--dim);
    font-size: 0.9rem;
  }

  .readme-body :global(h1),
  .readme-body :global(h2),
  .readme-body :global(h3) {
    margin: 1.4rem 0 0.6rem;
  }
  .readme-body :global(p) {
    color: var(--muted);
    line-height: 1.7;
    margin: 0 0 0.9rem;
  }
  .readme-body :global(a) {
    color: var(--accent-soft);
  }
  .readme-body :global(pre) {
    margin: 0 0 0.9rem;
  }
  .readme-body :global(ul),
  .readme-body :global(ol) {
    color: var(--muted);
    padding-left: 1.3rem;
    margin: 0 0 0.9rem;
  }
  .readme-body :global(img) {
    max-width: 100%;
  }
  .readme-body :global(table) {
    border-collapse: collapse;
    margin: 0 0 0.9rem;
  }
  .readme-body :global(th),
  .readme-body :global(td) {
    border: 1px solid var(--border);
    padding: 0.4rem 0.6rem;
    font-size: 0.9rem;
  }

  .files-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 18px;
  }
  @media (max-width: 640px) {
    .files-layout {
      grid-template-columns: 1fr;
    }
  }
  .files-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .files-list :global(li + li) {
    border-top: 1px solid var(--border);
  }
  .files-list :global(button) {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--panel);
    border: none;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.82rem;
    padding: 0.5rem 0.7rem;
    cursor: pointer;
  }
  .files-list :global(button:hover),
  .files-list :global(button.active) {
    background: var(--panel-2);
    color: var(--text);
  }
  .file-viewer {
    margin: 0;
    max-height: 480px;
    overflow: auto;
  }

  .diff-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.1rem;
  }
  .diff-controls select {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--mono);
    font-size: 0.85rem;
    padding: 0.4rem 0.6rem;
  }
  .diff-arrow {
    color: var(--dim);
    font-size: 0.85rem;
  }
  :global(.diff-file) {
    margin-bottom: 1rem;
  }
  :global(.diff-file-header) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 0.85rem;
    margin-bottom: 0.4rem;
  }
  :global(.diff-hunk) {
    margin: 0;
    padding: 0.35rem 0.7rem;
    font-size: 0.8rem;
    white-space: pre-wrap;
    border-left: 3px solid transparent;
  }
  :global(.diff-hunk.added) {
    background: rgba(34, 197, 94, 0.08);
    border-color: var(--green);
  }
  :global(.diff-hunk.removed) {
    background: rgba(248, 113, 113, 0.08);
    border-color: #f87171;
  }

  h2 {
    font-size: 1.15rem;
    margin: 2rem 0 1rem;
  }
  .versions,
  .requirements-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
  }
  .requirements-list strong {
    display: block;
    margin-bottom: 0.5rem;
  }
  .requirements-list pre {
    margin: 0;
  }
  .version-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .download-link {
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 8px;
    background: var(--panel-2);
    border: 1px solid var(--border);
  }
  .download-link:hover {
    border-color: var(--accent-soft);
    color: var(--accent-soft);
  }
  .changelog,
  .sha256 {
    color: var(--dim);
    font-size: 0.85rem;
    margin: 0.5rem 0 0;
  }
  .scan-badge {
    margin: 0.6rem 0 0;
  }
  .scan-badge.scan-clean {
    color: var(--green);
    border-color: rgba(34, 197, 94, 0.35);
    background: rgba(34, 197, 94, 0.08);
  }
  .scan-badge.scan-warning {
    color: #fbbf24;
    border-color: rgba(251, 191, 36, 0.35);
    background: rgba(251, 191, 36, 0.08);
  }
  .scan-badge.scan-malicious {
    color: #f87171;
    border-color: rgba(248, 113, 113, 0.35);
    background: rgba(248, 113, 113, 0.08);
  }

  .sidebar-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sidebar-meta {
    margin: 0;
  }
  .sidebar-meta-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    padding: 0.3rem 0;
  }
  .sidebar-meta-row + .sidebar-meta-row {
    border-top: 1px solid var(--border);
  }
  .sidebar-meta dt {
    color: var(--dim);
  }
  .sidebar-scan {
    align-self: flex-start;
  }
  .sidebar-action {
    width: 100%;
    justify-content: center;
  }
  .report-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .report-form[hidden] {
    display: none;
  }
  .report-form textarea {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font);
    font-size: 13px;
    padding: 8px 10px;
    resize: vertical;
  }
  .report-actions {
    display: flex;
    gap: 8px;
  }
  .install-hint {
    margin-top: 6px;
  }
  .install-hint-label {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    color: var(--dim);
  }
  .install-hint .terminal pre {
    font-size: 0.78rem;
    white-space: pre-wrap;
    word-break: break-all;
  }
</style>

<script
  define:vars={{
    pkgName: pkg.name,
    latestVersionStr: latestVersion?.version ?? null,
    I18N: {
      savingStatus: t.packageDetail.savingStatus,
      savedStatus: t.packageDetail.savedStatus,
      savingNetworkError: t.packageDetail.savingNetworkError,
      savingFailedTemplate: t.packageDetail.savingFailedTemplate,
      star: t.packageDetail.star,
      starred: t.packageDetail.starred,
      reportEmptyReason: t.packageDetail.reportEmptyReason,
      reportSendingStatus: t.packageDetail.reportSendingStatus,
      reportSent: t.packageDetail.reportSent,
      reportNetworkError: t.packageDetail.reportNetworkError,
      reportFailedTemplate: t.packageDetail.reportFailedTemplate,
      noReadme: t.packageDetail.noReadme,
      loadFailed: t.packageDetail.loadFailed,
      noFiles: t.packageDetail.noFiles,
      binaryFile: t.packageDetail.binaryFile,
      fileTooLarge: t.packageDetail.fileTooLarge,
      loadingLabel: t.packageDetail.loadingLabel,
      noDifference: t.packageDetail.noDifference,
      diffAdded: t.packageDetail.diffAdded,
      diffRemoved: t.packageDetail.diffRemoved,
      diffModified: t.packageDetail.diffModified,
      diffBinary: t.packageDetail.diffBinary,
    },
  }}
>
  window.__pepehubPkgName = pkgName;
  window.__pepehubLatestVersion = latestVersionStr;
  window.__pepehubI18n = I18N;
</script>
<script>
  const pkgName = (window as any).__pepehubPkgName as string;
  const latestVersion = (window as any).__pepehubLatestVersion as string | null;
  const I18N = (window as any).__pepehubI18n as Record<string, string>;
  const apiBase = `/api/v1/packages/${pkgName}`;

  // Edit form (metadata)
  const editToggle = document.getElementById('edit-toggle');
  const metadataForm = document.getElementById('metadata-form') as HTMLFormElement | null;
  const metadataCancel = document.getElementById('metadata-cancel');
  const metadataStatus = document.getElementById('metadata-status');
  const summaryDisplay = document.getElementById('summary-display');
  const categoryDisplay = document.getElementById('category-display');
  const categorySelect = document.getElementById('metadata-category') as HTMLSelectElement | null;

  editToggle?.addEventListener('click', () => metadataForm?.toggleAttribute('hidden'));
  metadataCancel?.addEventListener('click', () => {
    metadataForm?.setAttribute('hidden', '');
    if (metadataStatus) {
      metadataStatus.textContent = '';
      metadataStatus.className = 'status';
    }
  });

  metadataForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!metadataStatus || !metadataForm) return;
    const data = new FormData(metadataForm);
    const summary = String(data.get('summary') ?? '').trim();
    const category = String(data.get('category') ?? '');

    metadataStatus.textContent = I18N.savingStatus;
    metadataStatus.className = 'status';
    const submitButton = metadataForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;

    try {
      const res = await fetch(`${apiBase}/metadata`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ summary: summary || null, category }),
        credentials: 'include',
      });
      if (res.ok) {
        if (summaryDisplay) summaryDisplay.textContent = summary;
        if (categoryDisplay && categorySelect) {
          categoryDisplay.textContent = categorySelect.selectedOptions[0]?.textContent ?? category;
        }
        metadataStatus.textContent = I18N.savedStatus;
        metadataStatus.className = 'status success';
        metadataForm.setAttribute('hidden', '');
        return;
      }
      const errorBody = await res.json().catch(() => null);
      metadataStatus.textContent = errorBody?.message ?? I18N.savingFailedTemplate.replace('{status}', String(res.status));
      metadataStatus.className = 'status error';
    } catch {
      metadataStatus.textContent = I18N.savingNetworkError;
      metadataStatus.className = 'status error';
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });

  // Star
  const starToggle = document.getElementById('star-toggle') as HTMLButtonElement | null;
  const starLabel = document.getElementById('star-label');
  const starsCountEl = document.getElementById('stars-count');
  starToggle?.addEventListener('click', async () => {
    const starred = starToggle.dataset.starred === 'true';
    starToggle.disabled = true;
    try {
      const res = await fetch(`${apiBase}/${starred ? 'unstar' : 'star'}`, {
        method: 'POST',
        credentials: 'include',
      });
      if (res.ok) {
        const body = await res.json();
        starToggle.dataset.starred = String(body.starred);
        if (starLabel) starLabel.textContent = body.starred ? I18N.starred : I18N.star;
        if (starsCountEl) starsCountEl.textContent = String(body.starsCount);
      }
    } finally {
      starToggle.disabled = false;
    }
  });

  // Report
  const reportToggle = document.getElementById('report-toggle');
  const reportForm = document.getElementById('report-form') as HTMLFormElement | null;
  const reportCancel = document.getElementById('report-cancel');
  const reportStatus = document.getElementById('report-status');
  const reportReasonInput = document.getElementById('report-reason') as HTMLTextAreaElement | null;

  reportToggle?.addEventListener('click', () => reportForm?.toggleAttribute('hidden'));
  reportCancel?.addEventListener('click', () => {
    reportForm?.setAttribute('hidden', '');
    if (reportStatus) {
      reportStatus.textContent = '';
      reportStatus.className = 'status';
    }
  });

  reportForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!reportStatus || !reportForm) return;
    const reason = reportReasonInput?.value.trim() ?? '';
    if (!reason) {
      reportStatus.textContent = I18N.reportEmptyReason;
      reportStatus.className = 'status error';
      reportReasonInput?.focus();
      return;
    }
    const submitButton = reportForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;
    reportStatus.textContent = I18N.reportSendingStatus;
    reportStatus.className = 'status';

    try {
      const res = await fetch(`${apiBase}/reports`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason }),
        credentials: 'include',
      });
      if (res.ok) {
        reportStatus.textContent = I18N.reportSent;
        reportStatus.className = 'status success';
        reportForm.setAttribute('hidden', '');
        return;
      }
      const errorBody = await res.json().catch(() => null);
      reportStatus.textContent = errorBody?.message ?? I18N.reportFailedTemplate.replace('{status}', String(res.status));
      reportStatus.className = 'status error';
    } catch {
      reportStatus.textContent = I18N.reportNetworkError;
      reportStatus.className = 'status error';
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });

  // Tabs
  const tabButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab-btn'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.tab-panel'));
  const loadedTabs = new Set<string>();

  function activateTab(tabName: string) {
    tabButtons.forEach((b) => b.classList.toggle('active', b.dataset.tab === tabName));
    panels.forEach((p) => {
      if (p.dataset.panel === tabName) p.removeAttribute('hidden');
      else p.setAttribute('hidden', '');
    });
    loadTabContent(tabName);
  }
  tabButtons.forEach((b) => b.addEventListener('click', () => activateTab(b.dataset.tab ?? '')));

  const HTML_ESCAPES: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
  function escapeHtml(input: string): string {
    return input.replace(/[&<>"']/g, (ch) => HTML_ESCAPES[ch] ?? ch);
  }

  async function loadTabContent(tabName: string) {
    if (loadedTabs.has(tabName)) return;
    loadedTabs.add(tabName);
    if (tabName === 'readme') await loadReadme();
    else if (tabName === 'files') await loadFiles();
    else if (tabName === 'diff') await loadDiff();
    else loadedTabs.delete(tabName);
  }

  async function loadReadme() {
    const body = document.getElementById('readme-body');
    if (!body || !latestVersion) return;
    try {
      const res = await fetch(`${apiBase}/versions/${latestVersion}/readme`);
      const data = await res.json();
      if (data.found) {
        body.innerHTML = data.html;
      } else {
        body.innerHTML = '';
        const p = document.createElement('p');
        p.className = 'tab-empty';
        p.textContent = I18N.noReadme;
        body.appendChild(p);
      }
    } catch {
      body.textContent = I18N.loadFailed;
    }
  }

  async function loadFiles() {
    const list = document.getElementById('files-list');
    const viewer = document.getElementById('file-viewer');
    if (!list || !viewer || !latestVersion) return;
    try {
      const res = await fetch(`${apiBase}/versions/${latestVersion}/files`);
      const data = await res.json();
      list.innerHTML = '';
      if (!data.items.length) {
        const li = document.createElement('li');
        li.className = 'tab-empty';
        li.textContent = I18N.noFiles;
        list.appendChild(li);
        return;
      }
      for (const item of data.items) {
        const li = document.createElement('li');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = item.path;
        button.addEventListener('click', async () => {
          list.querySelectorAll('button').forEach((b) => b.classList.remove('active'));
          button.classList.add('active');
          const encodedPath = item.path.split('/').map(encodeURIComponent).join('/');
          const fileRes = await fetch(`${apiBase}/versions/${latestVersion}/files/${encodedPath}`);
          const fileData = await fileRes.json();
          const code = viewer.querySelector('code') ?? document.createElement('code');
          if (fileData.isBinary) {
            code.textContent = I18N.binaryFile;
          } else if (fileData.truncated) {
            code.textContent = I18N.fileTooLarge;
          } else {
            code.textContent = fileData.content ?? '';
          }
          viewer.innerHTML = '';
          viewer.appendChild(code);
        });
        li.appendChild(button);
        list.appendChild(li);
      }
    } catch {
      list.innerHTML = `<li class="tab-empty">${I18N.loadFailed}</li>`;
    }
  }

  async function loadDiff() {
    const body = document.getElementById('diff-body');
    const fromSelect = document.getElementById('diff-from') as HTMLSelectElement | null;
    const toSelect = document.getElementById('diff-to') as HTMLSelectElement | null;
    if (!body || !fromSelect || !toSelect) return;

    async function fetchAndRender() {
      if (!body || !fromSelect || !toSelect) return;
      body.innerHTML = `<p class="tab-loading">${I18N.loadingLabel}</p>`;
      try {
        const res = await fetch(`${apiBase}/diff?from=${fromSelect.value}&to=${toSelect.value}`);
        const data = await res.json();
        body.innerHTML = '';
        if (!data.files.length) {
          const p = document.createElement('p');
          p.className = 'tab-empty';
          p.textContent = I18N.noDifference;
          body.appendChild(p);
          return;
        }
        for (const file of data.files) {
          const wrap = document.createElement('div');
          wrap.className = 'diff-file';
          const header = document.createElement('div');
          header.className = 'diff-file-header';
          const statusLabel: Record<string, string> = {
            added: I18N.diffAdded,
            removed: I18N.diffRemoved,
            modified: I18N.diffModified,
            binary: I18N.diffBinary,
          };
          header.innerHTML = `<code>${escapeHtml(file.path)}</code><span class="badge">${statusLabel[file.status] ?? file.status}</span>`;
          wrap.appendChild(header);
          if (file.status === 'modified' && Array.isArray(file.hunks)) {
            for (const hunk of file.hunks) {
              const pre = document.createElement('pre');
              pre.className = `diff-hunk ${hunk.added ? 'added' : hunk.removed ? 'removed' : ''}`;
              pre.textContent = hunk.value;
              wrap.appendChild(pre);
            }
          }
          body.appendChild(wrap);
        }
      } catch {
        body.innerHTML = `<p class="tab-empty">${I18N.loadFailed}</p>`;
      }
    }

    fromSelect.addEventListener('change', fetchAndRender);
    toSelect.addEventListener('change', fetchAndRender);
    await fetchAndRender();
  }

  // README já é a aba padrão visível ao carregar a página.
  loadTabContent('readme');
</script>
