---
import { useTranslations } from '../../i18n/utils';
import { CATEGORIES } from '../../lib/categories';
import { categoryLabels } from '../../lib/constants';
import { MAX_SUMMARY_LENGTH } from '../../lib/manifest';
import Base from '../../layouts/Base.astro';

const session = Astro.locals.session;
const locale = Astro.locals.locale;
const t = useTranslations(locale);
const CATEGORY_LABELS = categoryLabels(locale);
---

<Base title={t.upload.title}>
  <h1>{t.upload.title}</h1>
  <p class="lead">
    {t.upload.lead}
  </p>

  <h2>{t.upload.howToPackageTitle}</h2>
  <p class="lead">
    {t.upload.howToPackageLead1} <a
      href="https://pepe-agent.com/pt-br/docs/skills"
      rel="noopener">{t.upload.howToPackageSkillsLink}</a
    > {t.common.and} <a href="https://pepe-agent.com/pt-br/docs/plugins" rel="noopener">{t.upload.howToPackagePluginsLink}</a
    >{t.upload.howToPackageLead2}
  </p>

  <div class="examples">
    <div class="example">
      <h3>{t.upload.skillExampleTitle}</h3>
      <p>{t.upload.skillExampleLead}</p>
      <div class="terminal">
        <div class="bar"><i></i><i></i><i></i></div>
        <pre><code>meu-skill.zip
└── meu-skill.md</code></pre>
      </div>
    </div>

    <div class="example">
      <h3>{t.upload.pluginExampleTitle}</h3>
      <p>{t.upload.pluginExampleLead}</p>
      <div class="terminal">
        <div class="bar"><i></i><i></i><i></i></div>
        <pre><code>meu-plugin.tgz
├── manifest.json
└── meu-plugin.exs</code></pre>
      </div>
    </div>
  </div>

  {
    !session && (
      <div class="card login-prompt">
        <p>{t.upload.loginPrompt}</p>
        <a class="btn btn-primary" href="/login">
          {t.upload.loginButton}
        </a>
      </div>
    )
  }

  {
    session && (
      <>
        <h2>{t.upload.formTitle}</h2>
        <form id="upload-form" class="card" novalidate>
          <div class="field">
            <label for="slug">{t.upload.fieldName}</label>
            <div class="namespaced-input">
              <span class="prefix">@{session.handle}/</span>
              <input type="text" id="slug" name="slug" placeholder={t.upload.namePlaceholder} />
            </div>
          </div>

          <div class="field">
            <label>{t.upload.fieldType}</label>
            <div class="radio-row">
              <label class="radio">
                <input type="radio" name="kind" value="skill" checked /> {t.upload.typeSkill}
              </label>
              <label class="radio">
                <input type="radio" name="kind" value="plugin" /> {t.upload.typePlugin}
              </label>
            </div>
            <p id="kind-locked-hint" class="field-hint" style="display: none;">{t.upload.kindLockedHint}</p>
          </div>

          <p id="existing-package-note" class="existing-note" style="display: none;"></p>

          <div class="field-row">
            <div class="field">
              <label for="version">{t.upload.fieldVersion}</label>
              <input type="text" id="version" name="version" placeholder={t.upload.versionPlaceholder} />
            </div>
            <div class="field new-package-only">
              <label for="category">{t.upload.fieldCategory}</label>
              <select id="category" name="category">
                {CATEGORIES.map((cat) => (
                  <option value={cat}>{CATEGORY_LABELS[cat] ?? cat}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="field new-package-only">
            <label for="summary">{t.upload.fieldSummary}</label>
            <textarea id="summary" name="summary" rows="6" maxlength={MAX_SUMMARY_LENGTH} placeholder={t.upload.summaryPlaceholder}></textarea>
            <span id="summary-counter" class="char-counter">0 / {MAX_SUMMARY_LENGTH}</span>
          </div>

          <div class="field">
            <label for="changelog">{t.upload.fieldChangelog}</label>
            <textarea id="changelog" name="changelog" rows="3"></textarea>
          </div>

          <div class="field">
            <label for="artifact">{t.upload.fieldFile}</label>
            <input type="file" id="artifact" name="artifact" accept=".zip,.tgz,.tar.gz" />
          </div>

          <button type="submit" class="btn btn-primary">{t.upload.submit}</button>
          <p id="upload-status" class="status"></p>
        </form>
      </>
    )
  }
</Base>

<style>
  h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(26px, 4vw, 36px);
  }
  h2 {
    font-size: 1.2rem;
    margin: 2.5rem 0 0.85rem;
  }
  h3 {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  .lead {
    color: var(--muted);
    line-height: 1.7;
    max-width: 640px;
  }
  .login-prompt {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 1.5rem;
  }
  .login-prompt p {
    margin: 0;
    color: var(--muted);
  }
  form.card {
    margin-top: 1.5rem;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-row {
    display: flex;
    gap: 18px;
  }
  .field-row .field {
    flex: 1;
  }
  label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  input[type='text'],
  input[type='file'],
  select,
  textarea {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: var(--font);
    font-size: 15px;
    padding: 9px 12px;
  }
  textarea {
    resize: vertical;
  }
  .namespaced-input {
    display: flex;
    align-items: center;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding-left: 12px;
  }
  .namespaced-input .prefix {
    color: var(--dim);
    font-family: var(--mono);
    font-size: 14px;
    white-space: nowrap;
  }
  .namespaced-input input {
    border: none;
    background: none;
    flex: 1;
  }
  .radio-row {
    display: flex;
    gap: 20px;
  }
  .radio {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 400;
    color: var(--muted);
  }
  .field-hint {
    margin: 0;
    font-size: 13px;
    color: var(--dim);
  }
  .char-counter {
    align-self: flex-end;
    font-size: 12px;
    color: var(--dim);
  }
  .char-counter.char-counter-limit {
    color: #f87171;
  }
  .existing-note {
    margin: 0;
    padding: 10px 12px;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
    color: var(--muted);
  }
  .status {
    margin: 0;
    font-size: 14px;
    min-height: 1.4em;
  }
  .status.error {
    color: #f87171;
  }
  .status.success {
    color: var(--green);
  }
  .field.field-error label {
    color: #f87171;
  }
  .field.field-error input,
  .field.field-error select,
  .field.field-error .namespaced-input {
    border-color: #f87171;
  }
  .examples {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    max-width: 800px;
  }
  .example p {
    color: var(--muted);
    font-size: 14px;
    margin: 0 0 0.6rem;
  }
  .example .terminal pre {
    font-size: 13px;
  }
</style>

<script define:vars={{
  MAX_SUMMARY_LENGTH,
  I18N: {
    errNameFormat: t.upload.errNameFormat,
    errVersionFormat: t.upload.errVersionFormat,
    errFileRequired: t.upload.errFileRequired,
    errFileTypeMismatchTemplate: t.upload.errFileTypeMismatchTemplate,
    statusPublishing: t.upload.statusPublishing,
    statusPublished: t.upload.statusPublished,
    statusNetworkError: t.upload.statusNetworkError,
    statusFailedTemplate: t.upload.statusFailedTemplate,
    typeSkill: t.upload.typeSkill,
    typePlugin: t.upload.typePlugin,
    existingPackageNoteTemplate: t.upload.existingPackageNoteTemplate,
  },
}}>
  window.__pepehubUploadI18n = I18N;
  window.__pepehubMaxSummaryLength = MAX_SUMMARY_LENGTH;
</script>
<script>
  const I18N = (window as any).__pepehubUploadI18n as Record<string, string>;
  const MAX_SUMMARY_LENGTH = (window as any).__pepehubMaxSummaryLength as number;

  const form = document.getElementById('upload-form') as HTMLFormElement | null;
  const status = document.getElementById('upload-status');
  const slugInput = document.getElementById('slug') as HTMLInputElement | null;
  const versionInput = document.getElementById('version') as HTMLInputElement | null;
  const artifactInput = document.getElementById('artifact') as HTMLInputElement | null;
  const summaryInput = document.getElementById('summary') as HTMLTextAreaElement | null;
  const summaryCounter = document.getElementById('summary-counter');

  function updateSummaryCounter() {
    if (!summaryInput || !summaryCounter) return;
    const length = summaryInput.value.length;
    summaryCounter.textContent = `${length} / ${MAX_SUMMARY_LENGTH}`;
    summaryCounter.classList.toggle('char-counter-limit', length >= MAX_SUMMARY_LENGTH);
  }
  summaryInput?.addEventListener('input', updateSummaryCounter);
  const kindRadios = form?.querySelectorAll<HTMLInputElement>('input[name="kind"]');
  const kindLockedHint = document.getElementById('kind-locked-hint');
  const existingPackageNote = document.getElementById('existing-package-note');
  const newPackageFields = form?.querySelectorAll<HTMLElement>('.new-package-only');

  const SLUG_RE = /^[a-z0-9][a-z0-9-]*$/;
  const VERSION_RE = /^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$/;

  function applyExistingPackageState(pkg: { kind: string; latestVersion: string | null } | null) {
    if (pkg) {
      newPackageFields?.forEach((el) => {
        el.style.display = 'none';
      });
      if (existingPackageNote) {
        const kindLabel = pkg.kind === 'plugin' ? I18N.typePlugin : I18N.typeSkill;
        existingPackageNote.textContent = I18N.existingPackageNoteTemplate
          .replace('{kind}', kindLabel)
          .replace('{version}', pkg.latestVersion ?? '?');
        existingPackageNote.style.display = '';
      }
      kindRadios?.forEach((radio) => {
        radio.checked = radio.value === pkg.kind;
        radio.disabled = true;
      });
      if (kindLockedHint) kindLockedHint.style.display = '';
    } else {
      newPackageFields?.forEach((el) => {
        el.style.display = '';
      });
      if (existingPackageNote) existingPackageNote.style.display = 'none';
      kindRadios?.forEach((radio) => {
        radio.disabled = false;
      });
      if (kindLockedHint) kindLockedHint.style.display = 'none';
    }
  }

  let existingCheckToken = 0;
  let existingCheckTimer: ReturnType<typeof setTimeout> | undefined;

  async function checkExistingPackage() {
    const token = ++existingCheckToken;
    const slug = slugInput?.value.trim() ?? '';
    if (!SLUG_RE.test(slug)) {
      applyExistingPackageState(null);
      return;
    }
    const prefix = document.querySelector('.namespaced-input .prefix')?.textContent ?? '';
    const owner = prefix.replace('/', '');
    try {
      const res = await fetch(`/api/v1/packages/${owner}/${slug}`, { credentials: 'include' });
      if (token !== existingCheckToken) return;
      applyExistingPackageState(res.ok ? await res.json() : null);
    } catch {
      if (token !== existingCheckToken) return;
      applyExistingPackageState(null);
    }
  }

  slugInput?.addEventListener('input', () => {
    clearTimeout(existingCheckTimer);
    existingCheckTimer = setTimeout(checkExistingPackage, 400);
  });

  function clearFieldErrors() {
    form?.querySelectorAll('.field-error').forEach((el) => el.classList.remove('field-error'));
  }

  function showFieldError(input: HTMLElement, message: string) {
    clearFieldErrors();
    input.closest('.field')?.classList.add('field-error');
    if (status) {
      status.textContent = message;
      status.className = 'status error';
    }
    input.focus();
  }

  form?.addEventListener('input', () => clearFieldErrors());

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    clearFieldErrors();

    const data = new FormData(form);
    const slug = String(data.get('slug') ?? '').trim();
    const version = String(data.get('version') ?? '').trim();
    const artifact = data.get('artifact');

    if (!SLUG_RE.test(slug)) {
      if (slugInput) showFieldError(slugInput, I18N.errNameFormat);
      return;
    }
    if (!VERSION_RE.test(version)) {
      if (versionInput) showFieldError(versionInput, I18N.errVersionFormat);
      return;
    }
    if (!(artifact instanceof File) || artifact.size === 0) {
      if (artifactInput) showFieldError(artifactInput, I18N.errFileRequired);
      return;
    }

    // Lê do radio marcado em vez de FormData: quando o pacote já existe, os
    // radios de kind ficam com disabled=true (pra travar a escolha), e um
    // input disabled não entra no FormData de jeito nenhum.
    const kind = form.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value ?? null;
    const expectedExt = kind === 'plugin' ? '.tgz' : '.zip';
    if (!artifact.name.toLowerCase().endsWith(expectedExt)) {
      if (artifactInput) {
        const message = I18N.errFileTypeMismatchTemplate
          .replace('{type}', kind === 'plugin' ? 'Plugin' : 'Skill')
          .replace('{ext}', expectedExt)
          .replace('{name}', artifact.name);
        showFieldError(artifactInput, message);
      }
      return;
    }

    const manifest = {
      kind,
      version: data.get('version'),
      category: data.get('category'),
      summary: data.get('summary') || null,
      changelog: data.get('changelog') || null,
    };

    const body = new FormData();
    body.set('manifest', JSON.stringify(manifest));
    body.set('artifact', artifact);

    const prefix = document.querySelector('.namespaced-input .prefix')?.textContent ?? '';
    const owner = prefix.replace('/', '');

    status.textContent = I18N.statusPublishing;
    status.className = 'status';

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;

    try {
      // Sem encodeURIComponent: "@" é válido num path segment sem escapar, e
      // é assim que a CLI já manda (ver tests/package-publish.test.ts). Um
      // "%40" escapado aqui não volta a virar "@" do lado do servidor,
      // quebrando a checagem de namespace.
      const res = await fetch(`/api/v1/packages/${owner}/${slug}/versions`, {
        method: 'POST',
        body,
        credentials: 'include',
      });

      if (res.ok) {
        status.textContent = I18N.statusPublished;
        status.className = 'status success';
        const section = manifest.kind === 'skill' ? 'skills' : 'packages';
        window.location.href = `/${section}/${owner}/${slug}`;
        return;
      }

      const errorBody = await res.json().catch(() => null);
      status.textContent = errorBody?.message ?? I18N.statusFailedTemplate.replace('{status}', String(res.status));
      status.className = 'status error';
    } catch {
      status.textContent = I18N.statusNetworkError;
      status.className = 'status error';
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
