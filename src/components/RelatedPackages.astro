---
import { useTranslations } from '../i18n/utils';
import { categoryLabels } from '../lib/constants';
import type { SearchResultItem } from '../lib/db';

interface Props {
  items: SearchResultItem[];
  category: string;
  kind: 'plugin' | 'skill';
}
const { items, category, kind } = Astro.props;
const t = useTranslations(Astro.locals.locale);
const CATEGORY_LABELS = categoryLabels(Astro.locals.locale);
const kindLabel = kind === 'skill' ? 'skills' : 'plugins';
const moreHref = `/?category=${category}&kind=${kind}`;
---

{
  items.length > 0 && (
    <section class="related">
      <h2>{kind === 'skill' ? t.related.skillsHeading : t.related.pluginsHeading}</h2>
      <ul class="related-list">
        {items.map((item) => {
          const href = `/${kindLabel}/${item.name}`;
          return (
            <li>
              <a class="related-item" href={href}>
                <span class={`icon icon-${item.category}`} aria-hidden="true">
                  {item.category === 'channel' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="4" y="5" width="16" height="12" rx="3" />
                      <circle cx="9" cy="11" r="1" fill="currentColor" />
                      <circle cx="12" cy="11" r="1" fill="currentColor" />
                      <circle cx="15" cy="11" r="1" fill="currentColor" />
                    </svg>
                  )}
                  {item.category === 'tool' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <line x1="4" y1="6" x2="20" y2="6" />
                      <circle cx="9" cy="6" r="2" />
                      <line x1="4" y1="12" x2="20" y2="12" />
                      <circle cx="15" cy="12" r="2" />
                      <line x1="4" y1="18" x2="20" y2="18" />
                      <circle cx="9" cy="18" r="2" />
                    </svg>
                  )}
                  {item.category === 'integration' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <line x1="9" y1="2" x2="9" y2="6" />
                      <line x1="15" y1="2" x2="15" y2="6" />
                      <rect x="6" y="6" width="12" height="8" rx="2" />
                      <line x1="12" y1="14" x2="12" y2="19" />
                      <line x1="8" y1="19" x2="16" y2="19" />
                    </svg>
                  )}
                  {item.category === 'model' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="6" y="6" width="12" height="12" rx="2" />
                      <rect x="10" y="10" width="4" height="4" />
                      <line x1="9" y1="2" x2="9" y2="6" />
                      <line x1="15" y1="2" x2="15" y2="6" />
                      <line x1="9" y1="18" x2="9" y2="22" />
                      <line x1="15" y1="18" x2="15" y2="22" />
                      <line x1="2" y1="9" x2="6" y2="9" />
                      <line x1="18" y1="9" x2="22" y2="9" />
                      <line x1="2" y1="15" x2="6" y2="15" />
                      <line x1="18" y1="15" x2="22" y2="15" />
                    </svg>
                  )}
                  {item.category === 'automation' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="12" cy="12" r="9" />
                      <polyline points="12 7 12 12 15 15" />
                    </svg>
                  )}
                  {item.category === 'other' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="4" y="4" width="16" height="16" rx="3" />
                      <line x1="4" y1="10" x2="20" y2="10" />
                      <line x1="10" y1="10" x2="10" y2="20" />
                    </svg>
                  )}
                </span>
                <span class="body">
                  <span class="title">
                    <strong>{item.name}</strong>
                    <span class="handle">@{item.owner_handle}</span>
                  </span>
                  <p class="summary">{item.summary ?? t.related.noSummary}</p>
                </span>
                <span class="downloads">{item.downloads_count.toLocaleString(Astro.locals.locale)}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <a class="btn btn-ghost more-link" href={moreHref}>
        {t.related.moreIn} {CATEGORY_LABELS[category] ?? category}
      </a>
    </section>
  )
}

<style>
  .related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .related h2 {
    font-size: 1.15rem;
    margin: 0 0 1rem;
  }
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .related-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }
  li:last-child .related-item {
    border-bottom: none;
  }
  .related-item:hover {
    color: inherit;
  }
  .related-item:hover .title strong {
    color: var(--accent-soft);
  }
  .icon {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
  }
  .icon svg {
    width: 18px;
    height: 18px;
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  .title {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .title strong {
    font-size: 0.98rem;
  }
  .handle {
    color: var(--dim);
    font-size: 0.82rem;
    font-family: var(--mono);
  }
  .summary {
    margin: 0.2rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .downloads {
    flex: none;
    color: var(--dim);
    font-size: 0.85rem;
  }
  .more-link {
    margin-top: 1.25rem;
    width: 100%;
    justify-content: center;
  }
</style>
