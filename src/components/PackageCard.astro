---
import { CATEGORY_LABELS } from '../lib/constants';
import type { SearchResultItem } from '../lib/db';

interface Props {
  item: SearchResultItem;
}
const { item } = Astro.props;
const detailHref = `/${item.kind === 'skill' ? 'skills' : 'packages'}/${item.name}`;
---

<a class="card package-card" href={detailHref}>
  <div class="row">
    <strong>{item.name}</strong>
    {item.official ? <span class="badge official">oficial</span> : null}
  </div>
  <p class="summary">{item.summary ?? 'Sem resumo.'}</p>
  <div class="meta">
    <span class="badge">{CATEGORY_LABELS[item.category] ?? item.category}</span>
    <span class="owner">@{item.owner_handle}</span>
    <span class="downloads">{item.downloads_count} downloads</span>
  </div>
</a>

<style>
  .package-card {
    display: block;
    text-decoration: none;
    margin-bottom: 0.75rem;
  }
  .package-card .row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .package-card .summary {
    color: var(--text-muted);
    margin: 0.4rem 0 0.6rem;
  }
  .package-card .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
